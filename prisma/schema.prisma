generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id                  String    @id @default(cuid())
  email               String    @unique
  password            String
  name                String
  passwordChangedAt   DateTime  @default(now())
  mustChangePassword  Boolean   @default(false)
  tokenVersion        Int       @default(0)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  mfaEnabled          Boolean   @default(false)
  mfaSecret           String?
  // Time step of the last authenticator code accepted, so a code can't be used twice.
  mfaLastTimeStep     Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  auditLogs    AdminAuditLog[]
  sessions     AdminSession[]
}

model AdminSession {
  id        String    @id @default(cuid())
  adminId   String
  jti       String    @unique
  ip        String?
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

model SecurityEvent {
  id        String   @id @default(cuid())
  category  String
  action    String
  metadata  String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([category])
  @@index([createdAt])
}

model PasswordResetOtp {
  id           String   @id @default(cuid())
  email        String
  otp          String
  resetToken   String   @unique @default(cuid())
  attemptCount Int      @default(0)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  resource  String?
  metadata  String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

model GalleryImage {
  id           String   @id @default(cuid())
  title        String
  description  String?
  imageUrl     String
  cloudinaryId String
  category     String
  featured     Boolean  @default(false)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([featured])
}

model Service {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  priceUSD    Float?
  priceNGN    Float?
  priceNote   String?
  featured    Boolean  @default(false)
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
}

model BookingRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  service   String
  message   String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model SiteSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Invoice {
  id                 String   @id @default(cuid())
  invoiceNumber      String   @unique
  clientName         String
  clientAddress      String?
  currency           String   @default("NGN")
  items              String
  notes              String?
  reference          String?
  dueDate            DateTime
  status             String   @default("unpaid")
  // JSON array of PaymentAccount IDs selected for this invoice.
  // Empty/null = show all active accounts matching currency.
  paymentAccountIds  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model PaymentAccount {
  id            String   @id @default(cuid())
  label         String
  // Type: "bank" | "paypal" | "wise" | "other"
  type          String   @default("bank")
  currency      String
  // Bank-specific fields (required for type=bank, nullable for others)
  bankName      String?
  accountName   String?
  accountNumber String?
  swiftCode     String?
  iban          String?
  sortCode      String?
  // Email-based fields (PayPal, Wise)
  email         String?
  // Generic fields
  notes         String?
  active        Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([currency])
  @@index([active])
  @@index([order])
  @@index([type])
}

model Subscriber {
  id                    String    @id @default(cuid())
  email                 String    @unique
  status                String    @default("pending")
  confirmToken          String?   @unique
  confirmTokenExpiresAt DateTime?
  unsubscribeToken      String    @unique
  confirmedAt           DateTime?
  unsubscribedAt        DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status])
  @@index([email])
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model Broadcast {
  id             String    @id @default(cuid())
  subject        String
  html           String
  text           String?
  // "sending" until every recipient has been tried, then "sent".
  status         String    @default("sent")
  sentAt         DateTime?
  recipientCount Int       @default(0)
  sentCount      Int       @default(0)
  failedCount    Int       @default(0)
  // Why sending last stopped early, such as Resend's daily limit.
  lastError      String?
  // Kept so every batch, retries included, carries the same unsubscribe links.
  siteUrl        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  recipients BroadcastRecipient[]

  @@index([sentAt])
  @@index([createdAt])
  @@index([status])
}

// One row per subscriber a broadcast goes to, so sending can be spread over
// several requests and every address's result is recorded.
model BroadcastRecipient {
  id               String    @id @default(cuid())
  broadcastId      String
  email            String
  unsubscribeToken String
  // "pending" | "sending" | "sent" | "failed" | "skipped" (unsubscribed before their turn)
  status           String    @default("pending")
  // The batch a "sending" row was claimed in. A retry reuses it as Resend's
  // idempotency key, so a batch that already went out isn't sent twice.
  batchKey         String?
  claimedAt        DateTime?
  providerId       String?
  error            String?
  sentAt           DateTime?
  createdAt        DateTime  @default(now())
  broadcast        Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, email])
  @@index([broadcastId, status])
}

// Request counts for rate limits that hold across server instances.
model RateLimitBucket {
  key         String   @id
  count       Int
  windowStart DateTime

  @@index([windowStart])
}

// Lagos in December consultation bookings (/december). Times are UTC.
model DecemberBooking {
  id              String    @id @default(cuid())
  // "pending" (held, awaiting payment, no invite yet) | "scheduled" (invited, unpaid)
  // | "paid" | "cancelled" | "expired" (hold lapsed without payment)
  status          String    @default("scheduled")
  // Client-generated id so a retried request can't book twice.
  clientRef       String    @unique
  name            String
  email           String
  whatsapp        String // E.164
  country         String
  occasions       String[]
  otherOccasion   String?
  looks           Int
  // [{ day: 1-31, title }] December plans from the timeline builder
  events          Json
  plans           String?
  styleWords      String[]
  styleNotes      String?
  styleLinks      String[]
  comments        String?
  consentAt       DateTime
  timezone        String // client's IANA zone, for emails
  slotStart       DateTime
  slotEnd         DateTime
  // Mirrors slotStart while the booking holds its slot; null once cancelled or failed.
  // The unique index is what stops two clients booking the same time.
  heldSlot        DateTime? @unique
  googleEventId   String?
  meetUrl         String?
  // SHA-256 of the token in the client's manage link
  manageTokenHash String    @unique
  // While pending: when the hold lapses and the slot is released.
  holdExpiresAt   DateTime?
  paidAt          DateTime?
  cancelledAt     DateTime?
  reminder24hAt   DateTime? // when the "tomorrow" reminder was sent
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([slotStart])
  @@index([holdExpiresAt])
}

// Progress saved once a client passes the contact step, so the stylist can follow up on
// anyone who stops before booking. Marked booked by clientRef when they finish.
model DecemberDraft {
  id        String    @id @default(cuid())
  clientRef String    @unique
  name      String
  email     String
  whatsapp  String // E.164
  country   String
  step      String // last screen reached
  brief     Json
  bookedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([bookedAt, updatedAt])
}
