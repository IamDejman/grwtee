# =============================================================================
# GRWTEE website: environment variables
# Copy to .env and fill in what you use. In Vercel, set them per environment
# (Production / Preview). Never commit real values.
# Settings marked "or dashboard" can be saved in Admin → Settings instead,
# which keeps them in the database.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Supabase Postgres)
# DATABASE_URL: the session pooler (port 5432). The site moves it to the
# transaction pooler (6543) itself (src/lib/database-url.ts).
# DIRECT_URL: the direct connection, used by `prisma migrate`. Production only:
# preview builds never migrate (scripts/vercel-build.sh).
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# -----------------------------------------------------------------------------
# Admin sign-in (NextAuth)
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
# Admins must set up an authenticator app unless this is "false".
ADMIN_REQUIRE_MFA="true"
# Optional: only these IPs may open /admin and the admin APIs (comma-separated).
ADMIN_ALLOWED_IPS=""
# Only for `npx prisma db seed`, which creates the first admin.
ADMIN_SEED_PASSWORD="your-secure-password-min-8-chars"

# -----------------------------------------------------------------------------
# Encryption and signed links
# DATA_ENCRYPTION_KEY: required in production; encrypts payment details and
# authenticator secrets. Generate with: openssl rand -base64 32
# When rotating, put the old key in DATA_ENCRYPTION_PREVIOUS_KEYS
# (comma-separated), then re-encrypt (Admin → Settings → Re-encrypt, or
# `npm run security:reencrypt`).
# PDF_SIGNING_SECRET: signs invoice PDF links; falls back to NEXTAUTH_SECRET.
# -----------------------------------------------------------------------------
DATA_ENCRYPTION_KEY=""
DATA_ENCRYPTION_PREVIOUS_KEYS=""
PDF_SIGNING_SECRET=""

# -----------------------------------------------------------------------------
# Scheduled jobs
# Vercel sends this to /api/cron/december-reminders. The app repo's
# api/supabase/28-scheduled-jobs.sql runs the other jobs (December holds,
# broadcasts, cleanup) and needs the same value in Supabase Vault as
# website_cron_secret.
# -----------------------------------------------------------------------------
CRON_SECRET="generate-with-openssl-rand-hex-32"

# -----------------------------------------------------------------------------
# Supabase (the app's data: stylists, looks, lookbooks, messages)
# Server-only: the service role key bypasses row-level security. Dashboard
# photos for looks and lookbooks upload to its storage.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# -----------------------------------------------------------------------------
# Cloudinary (the website's gallery) - or dashboard
# CLOUDINARY_MODERATION="true" checks new gallery uploads with Amazon
# Rekognition (needs the Cloudinary add-on).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_MODERATION=""

# -----------------------------------------------------------------------------
# Email (Resend) - or dashboard
# Get an API key at https://resend.com/api-keys. Send from a verified domain.
# -----------------------------------------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxx"
RESEND_FROM="GRWTEE <book@grwtee.com>"

# -----------------------------------------------------------------------------
# Site and contact - or dashboard
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://grwtee.com"
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/grwtee"
NEXT_PUBLIC_CONTACT_EMAIL="book@grwtee.com"
CONTACT_EMAIL="book@grwtee.com"

# -----------------------------------------------------------------------------
# Spam protection on the booking and contact forms (Cloudflare Turnstile)
# Leave both empty to turn it off.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# -----------------------------------------------------------------------------
# December booking
# Production only takes bookings when DECEMBER_BOOKING_ENABLED is "true".
# A Google service account with domain-wide delegation reads busy times and
# adds the calls: GOOGLE_CALENDAR_SUBJECT is the calendar it acts as, and
# DECEMBER_BUSY_CALENDARS lists more calendars to check (comma-separated).
# Keep the private key on one line with \n for each line break.
# -----------------------------------------------------------------------------
DECEMBER_BOOKING_ENABLED=""
GOOGLE_SA_EMAIL=""
GOOGLE_SA_PRIVATE_KEY=""
GOOGLE_CALENDAR_SUBJECT="book@grwtee.com"
DECEMBER_BUSY_CALENDARS=""

# -----------------------------------------------------------------------------
# Error tracking (Sentry). Leave the DSNs empty to turn it off.
# Personal data is removed before anything is sent (src/lib/sentry-scrub.ts).
# The build uploads source maps only when SENTRY_AUTH_TOKEN, SENTRY_ORG and
# SENTRY_PROJECT are all set.
# -----------------------------------------------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# -----------------------------------------------------------------------------
# Analytics (Google Analytics 4), e.g. G-XXXXXXXXXX. Leave empty to turn it off.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
